# Copy to .env.local and fill in real values. Never commit .env.local.
# .env* is already gitignored (see .gitignore).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (docs/05-sanity-schema-plan.md) ---
# Project ID + dataset from https://www.sanity.io/manage — see docs/08-ui-foundation-summary.md
# for the account-verification status before these are filled in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Server-only token (Editor or Viewer, per Sanity API tokens) — used by app/api/revalidate
# for on-demand ISR and by any server-side write access. Never expose with NEXT_PUBLIC_.
SANITY_API_TOKEN=
# Shared secret checked against Sanity's webhook payload before triggering revalidation.
SANITY_REVALIDATE_SECRET=

# --- Transactional email (lib/email.ts — provider not yet chosen) ---
# e.g. Resend: RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Bot protection on lead forms (contact / affiliate / quick-inquiry) ---
# e.g. Cloudflare Turnstile: NEXT_PUBLIC_TURNSTILE_SITE_KEY= / TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Supabase (NOT wired up yet — placeholders only, per explicit instruction) ---
# Do not set these until Supabase integration is explicitly requested.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
