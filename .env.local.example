# Copy to .env.local and fill in real values. Never commit .env.local.
# .env* is already gitignored (see .gitignore).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel production URL once deployed: https://mw-host-ai.vercel.app

# --- Transactional email (lib/email.ts, provider: Resend) ---
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend (magicworkshost.com is registered
# there; add its DNS records — docs/14-dashboard-handover.md). Until then this falls back to
# Resend's test sender "onboarding@resend.dev", which only delivers to the Resend account
# owner's address. magicworkshost.com has DMARC p=reject, so never set an @magicworkshost.com
# sender before the domain shows "Verified" in Resend.
# e.g. EMAIL_FROM_ADDRESS="MagicWorks Host <notifications@magicworkshost.com>"
EMAIL_FROM_ADDRESS=
# Where lead / quote / newsletter notifications are sent (comma-separate several).
# Defaults to abhimagicsquad@gmail.com (src/lib/email.ts).
ADMIN_NOTIFICATION_EMAIL=

# --- Bot protection: Cloudflare Turnstile (lead, quote and newsletter forms) ---
# Create a widget at dash.cloudflare.com > Turnstile for the production hostname. When BOTH
# are set, the forms show the challenge and /api/leads + /api/newsletter verify the token
# server-side; while either is blank the forms rely on honeypot, fill-time and rate limits.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Billing / client area (WHMCS) ---
# Base URL of the WHMCS install used for "Buy Now" cart links, Login and domain search.
# Defaults to https://www.magicworkshost.com/clients (src/lib/billing.ts).
NEXT_PUBLIC_BILLING_URL=

# --- Supabase (lead storage — see supabase/migrations/0001_create_leads.sql) ---
# /api/leads inserts into the `leads` table via the service role key (server-only, never
# exposed with NEXT_PUBLIC_). Until these are set, lead storage is skipped (logged, not an
# error) and the pipeline falls back to email-only, matching prior behavior.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Custom CMS admin (/admin — see docs/11-custom-cms.md) ---
# Signs admin session cookies. Optional: if unset, a key is derived from
# SUPABASE_SERVICE_ROLE_KEY. Set a long random value (e.g. `openssl rand -base64 48`) to
# decouple sessions from the Supabase key. Changing it signs every admin out.
ADMIN_SESSION_SECRET=
# Break-glass login that ONLY works while the CMS `users` table is missing or empty (i.e.
# before supabase/migrations/0004_create_cms.sql has been run). Leave blank in production.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
