# Copy to .env.local and fill in real values. Never commit .env.local.
# .env* is already gitignored (see .gitignore).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel production URL once deployed: https://mw-host-ai.vercel.app

# --- Sanity (docs/05-sanity-schema-plan.md) ---
# Real project — see docs/09-project-accounts.md for how this was verified/connected.
# Already set on Vercel (production/preview/development); these are the same values.
NEXT_PUBLIC_SANITY_PROJECT_ID=uf33qaon
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Server-only token (Editor or Viewer, per Sanity API tokens) — used by app/api/revalidate
# for on-demand ISR and by any server-side write access. Never expose with NEXT_PUBLIC_.
SANITY_API_TOKEN=
# Shared secret checked against Sanity's webhook payload before triggering revalidation.
SANITY_REVALIDATE_SECRET=

# --- Transactional email (lib/email.ts — provider not yet chosen) ---
# e.g. Resend: RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Bot protection on lead forms (contact / affiliate / quick-inquiry) ---
# e.g. Cloudflare Turnstile: NEXT_PUBLIC_TURNSTILE_SITE_KEY= / TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Supabase (lead storage — see supabase/migrations/0001_create_leads.sql) ---
# /api/leads inserts into the `leads` table via the service role key (server-only, never
# exposed with NEXT_PUBLIC_). Until these are set, lead storage is skipped (logged, not an
# error) and the pipeline falls back to email-only, matching prior behavior.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
